# Required: OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Optional: model slug used by the AI SDK / ADK agent
OPENROUTER_MODEL=openrouter/free

# Optional: ADK agent metadata
ADK_AGENT_NAME=code-reviewer
ADK_AGENT_DESCRIPTION=Base ADK agent prepared for future Code Reviewer integration.
ADK_AGENT_INSTRUCTION=You are a helpful coding assistant. Keep answers precise and actionable.
